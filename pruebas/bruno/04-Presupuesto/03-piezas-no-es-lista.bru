meta {
  name: 03-piezas-no-es-lista
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/collections/ordenes/records/{{ordenId}}
  body: json
  auth: none
}

body:json {
  {
    "estado": "presupuestada",
    "diagnostico": "Fuente",
    "manoObra": 20,
    "piezas": {
      "a": 1
    }
  }
}

tests {
  test("responde 400 (rechazado)", function () {
    expect(res.status).to.equal(400);
  });

  test("el servidor explica el motivo", function () {
    expect(res.body.message).to.contain("lista");
  });
}
