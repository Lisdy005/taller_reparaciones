meta {
  name: 02-empezar-reparacion
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/collections/ordenes/records/{{ordenId}}
  body: json
  auth: none
}

body:json {
  {
    "estado": "en_reparacion"
  }
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });

  test("la orden queda en 'en_reparacion'", function () {
    expect(res.body.estado).to.equal("en_reparacion");
  });
}
