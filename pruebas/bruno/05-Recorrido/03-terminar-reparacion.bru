meta {
  name: 03-terminar-reparacion
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/collections/ordenes/records/{{ordenId}}
  body: json
  auth: none
}

body:json {
  {
    "estado": "lista"
  }
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });

  test("la orden queda en 'lista'", function () {
    expect(res.body.estado).to.equal("lista");
  });
}
