meta {
  name: 02-listar-clientes
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/collections/clientes/records?sort=nombre
  body: none
  auth: none
}

params:query {
  sort: nombre
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });

  test("devuelve el formato de listado de PocketBase", function () {
    expect(res.body.items).to.be.an("array");
    expect(res.body.totalItems).to.be.at.least(1);
  });
}
