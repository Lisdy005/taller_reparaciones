meta {
  name: 04-cliente-rechaza
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/collections/ordenes/records/{{ordenRechazoId}}
  body: json
  auth: none
}

body:json {
  {
    "estado": "rechazada"
  }
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });

  test("la orden queda en 'rechazada'", function () {
    expect(res.body.estado).to.equal("rechazada");
  });
}
