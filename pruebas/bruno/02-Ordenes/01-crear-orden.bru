meta {
  name: 01-crear-orden
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/collections/ordenes/records
  body: json
  auth: none
}

body:json {
  {
    "cliente": "{{clienteId}}",
    "equipo": "Laptop de prueba",
    "problema": "No enciende"
  }
}

script:post-response {
  bru.setVar("ordenId", res.body.id);
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });

  test("la orden queda en 'solicitada'", function () {
    expect(res.body.estado).to.equal("solicitada");
  });
}

docs {
  No se envía estado: el hook onRecordCreateRequest lo pone en 'solicitada'.
}
